# Browser-visible values. The publishable key is public by design and relies on grants/RLS.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Para qué sirve este despliegue: local | staging | production.
# Decide si se exige el contrato de producción —dominio real, base real,
# institución real, secretos con entropía—. Vacío significa `production` cuando
# NODE_ENV=production, que es el default seguro: un despliegue real que se
# olvide de declararlo arranca con las comprobaciones puestas.
EGRESADO_ENVIRONMENT=local

# Server-only values. Never prefix the secret key with NEXT_PUBLIC_.
# Native development can omit SUPABASE_INTERNAL_URL and reuse the public URL.
SUPABASE_INTERNAL_URL=
SUPABASE_SECRET_KEY=

# Enables the development engine harness at /dev/game-engine.
# Server-only and opt-in; never set this on a public deployment.
EGRESADO_DEV_HARNESS=

# --- Competencia (STAGE-09) ---------------------------------------------------
# Slug de la edición activa de este despliegue. Con esto vacío el producto
# arranca igual y la portada dice que no hay competencia abierta.
EGRESADO_COMPETITION_SLUG=

# Secreto del HMAC que deriva la identidad de participante a partir del DNI.
# Al menos 32 caracteres de entropía real. Nunca se guarda en la base y nunca
# llega al navegador. Rotarlo durante una competencia abierta deja a los
# participantes sin poder reconocerse: se rota entre ediciones, no dentro de una.
#   pnpm secrets:generate          (imprime valores, no escribe ningún archivo)
#   openssl rand -base64 48
PARTICIPANT_IDENTITY_SECRET=

# Responsable del tratamiento de los datos. Se renderiza tal cual en el aviso de
# privacidad, así que tiene que ser la institución real: si falta alguno, el
# producto falla con un error de configuración en vez de mostrar un aviso con
# datos inventados.
EGRESADO_PRIVACY_CONTROLLER_NAME=
EGRESADO_PRIVACY_CONTROLLER_CONTACT=
EGRESADO_PRIVACY_CONTROLLER_ADDRESS=
EGRESADO_PRIVACY_NOTICE_VERSION=1
# Días desde el cierre hasta que los datos privados se anonimizan.
EGRESADO_PRIVACY_RETENTION_DAYS=120

# Años/cursos elegibles, separados por comas. Vacío usa la progresión del juego.
EGRESADO_SCHOOL_YEARS=
# Divisiones, si la escuela las necesita para distinguir estudiantes. Vacío
# oculta el campo: no se pide un dato que no hace falta.
EGRESADO_SCHOOL_DIVISIONS=

# Credencial del organizador. El digest lo produce:
#   pnpm competition:organizer:hash -- "<contraseña>"
# La contraseña en claro no se guarda en ningún lado. El separador es `:` y no
# `$` porque los cargadores de .env expanden `$nombre` y truncarían el digest.
EGRESADO_ORGANIZER_USERNAME=
EGRESADO_ORGANIZER_PASSWORD_HASH=

# --- Notas de operación -------------------------------------------------------
# Ninguno de estos valores se commitea. `pnpm release:preflight` comprueba, sin
# imprimirlos, que la configuración de este proceso alcanza para abrir una feria:
# dominio https propio, proyecto de base real, secreto con entropía, digest de
# organizador con costo suficiente y datos del responsable completos y no de
# ejemplo. Es el mismo contrato que el arranque exige cuando
# EGRESADO_ENVIRONMENT no es `local`.
