# Plantilla pública. Copiar con permisos 0600 a .env.production.local.
# Vercel: TODOS los valores solamente en Production; secretos como Secret/Sensitive.
# Elegir el origen real antes del build; alternativa: https://egresado-fdl26.vercel.app
NEXT_PUBLIC_APP_URL=https://egresado.vercel.app
EGRESADO_ENVIRONMENT=production
# Vercel usa packageManager=pnpm@11.22.0 mediante Corepack.
ENABLE_EXPERIMENTAL_COREPACK=1

# HTTPS Data API; configuración exclusiva del servidor.
SUPABASE_INTERNAL_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SECRET_KEY=<sb_secret_...>
# El navegador no necesita NEXT_PUBLIC_SUPABASE_URL ni NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
EGRESADO_DEV_HARNESS=false
EGRESADO_COMPETITION_SLUG=egresado-fdl-2026
PARTICIPANT_IDENTITY_SECRET=<GENERATE_AND_STORE_SECURELY>

EGRESADO_PRIVACY_CONTROLLER_NAME="Colegio Integral Piacentini"
EGRESADO_PRIVACY_CONTROLLER_CONTACT="Profesora de Matemática (maitezacgorac97@gmail.com)"
EGRESADO_PRIVACY_CONTROLLER_ADDRESS="Gobernador Florencio Tenev 250, Ruta Nacional 16, Colectora Norte Km 12, H3500 Resistencia, Chaco, Argentina"
EGRESADO_PRIVACY_NOTICE_VERSION=1
EGRESADO_PRIVACY_RETENTION_DAYS=30
EGRESADO_SCHOOL_YEARS="7.º,1.º,2.º,3.º,4.º,5.º"
# EGRESADO_SCHOOL_DIVISIONS omitida: no se recolecta división.

EGRESADO_ORGANIZER_USERNAME=organizador
EGRESADO_ORGANIZER_PASSWORD_HASH=<GENERATE_WITH_REPOSITORY_SCRIPT>
