{
  "name": "egresado",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Egresado web game technical foundation",
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.22.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.game.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:only": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "design:check": "node scripts/design/check-tokens.mjs && node scripts/design/check-contrast.mjs",
    "game:validate-content": "vite-node --config vitest.config.ts scripts/game/validate-content.ts",
    "game:variants": "vite-node --config vitest.config.ts scripts/game/variants.ts",
    "game:compose": "vite-node --config vitest.config.ts scripts/game/compose.ts",
    "game:simulate": "vite-node --config vitest.config.ts scripts/game/simulate.ts",
    "game:simulate:deep": "vite-node --config vitest.config.ts scripts/game/simulate.ts -- --runs=5000 --verify=5",
    "db:start": "node scripts/start-local-supabase.mjs",
    "db:stop": "supabase stop",
    "db:status": "node scripts/local-supabase-status.mjs",
    "db:env": "node scripts/write-local-env.mjs",
    "db:reset": "node scripts/reset-local-database.mjs",
    "db:migration": "supabase migration new",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "db:types": "node scripts/generate-db-types.mjs",
    "docker:build": "docker build --target runner --tag egresado:local .",
    "docker:up": "node scripts/start-compose.mjs",
    "docker:down": "docker compose down --remove-orphans",
    "secrets:check": "node scripts/check-secrets.mjs",
    "security:audit": "pnpm audit --audit-level high",
    "release:check": "node scripts/check-release-readiness.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.3.3",
    "pure-rand": "8.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.2.0",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "next-devtools-mcp": "0.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.115.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite-node": "6.0.0",
    "vitest": "4.1.11"
  }
}
